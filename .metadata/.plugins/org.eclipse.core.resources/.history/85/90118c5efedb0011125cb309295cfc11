#include "led.h"
#include "stm32f4xx_hal.h"



void led_init(button_t *led, GPIO_TypeDef* GPIOx, uint16_t GPIO_Pin)
{
	led->GPIOx = GPIOx;
	led->GPIO_Pin = GPIO_Pin;
}

void led_allOff(void)
{
	HAL_GPIO_WritePin(LED_EMERGENCY, LED_EMERGENCY_PIN, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(LED_FLOOR_1, LED_FLOOR_1_PIN, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(LED_FLOOR_2, LED_FLOOR_2_PIN, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(LED_FLOOR_3, LED_FLOOR_3_PIN, GPIO_PIN_RESET);
}
