#include "counter.h"
#include "../../../driver/joyStick/joyStick.h"
#include <stdio.h>

#define POS		1
#define NEG		0

cordinate_XY cord_value;


static typedef struct {
	uint16_t x_abs;
	uint8_t x_sign;
	uint16_t y_abs;
	uint8_t y_sign;
} cordData_t;




count_XY count_num;
cordData_t cordData;



upmode_state state;

void count_init(void)
{
	js_init();
	Lcd_init(&hi2c1);
	cordData.x_abs = 0;
	cordData.x_abs = 0;
	cordData.x_abs = 0;
	cordData.x_abs = 0;
}

void count_getCordData(void) {
	js_getValue(&cord_value);
}



void count_task(void)
{

	switch(state)
	{
	case X_MODE:
		if (cord_value.X_cord > 60 || cord_value.X_cord < 40)
		{
			count_num.count_X ++;
			x_abs = (count_num.count_X > 50) ? count_num.count_X - 50 : 50 - count_num.count_X;
		}
		break;
	case Y_MODE:
		if (cord_value.Y_cord > 60 || cord_value.Y_cord < 40)
		{
			count_num.count_Y ++;
		}
		break;
	case NOMAL :
		count_X = 0;
		count_Y = 0;
		if (cord_value.X_cord > cord_value.Y_cord)
			state = X_MODE;
		else
			state = Y_MODE;
		break;
	default :
		break;
	}

	d = max * 100;
	HAL_Delay(d);

	js_getValue(&cord_value);
	sprintf(str,"X : %d %%", cord_value.X_cord);
	//		printf("X : %d %%", cord_value.X_cord);
	//		HAL_Delay(100);
	Lcd_writeStringXY(0, 0, str);

	js_getValue(&cord_value);
	sprintf(str,"Y : %d %%", cord_value.Y_cord);
	//		printf("Y : %d %%", cord_value.Y_cord);
	//		HAL_Delay(100);
	Lcd_writeStringXY(1, 0, str);
}
