#include "counter.h"
#include "../../../driver/joyStick/joyStick.h"

cordinate_XY speed;

void count_init(void)
{
	js_init();
	Lcd_init(&hi2c1);
}

void count_task(void)
{
	js_getValue(&cord_value);
	sprintf(str,"X : %d %%", cord_value.X_cord);
	//		printf("X : %d %%", cord_value.X_cord);
	//		HAL_Delay(100);
	Lcd_writeStringXY(0, 0, str);

	js_getValue(&cord_value);
	sprintf(str,"Y : %d %%", cord_value.Y_cord);
	//		printf("Y : %d %%", cord_value.Y_cord);
	//		HAL_Delay(100);
	Lcd_writeStringXY(1, 0, str);
}
